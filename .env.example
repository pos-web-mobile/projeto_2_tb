# Database connection URL
# Para uso com Docker Compose (PostgreSQL mapeado na porta 5432):
DATABASE_URL="postgresql://admin:password123@localhost:5432/catalog_db?schema=public"

# Para desenvolvimento local com PostgreSQL em porta customizada (ex: 5433):
# DATABASE_URL="postgresql://admin:password123@localhost:5433/catalog_db?schema=public"

# Porta onde o servidor Express será iniciado
PORT=3000

# Origem autorizada no CORS (Front-end Vite/React ou similar)
ALLOWED_ORIGIN="http://localhost:5173"
